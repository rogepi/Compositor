      }
    },
    "Drag a point. Click to add one. Double-click a point to remove it." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖移点进行调整。点按可添加点，连按两下点可将其移除。"
          }
        }
      }
    },
    "Drag a rectangle · Shift add · Option subtract · Shift again mid-drag square · Drag inside to move · ⌘-drag moves pixels · Delete clears · ⌘D deselect" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖移出矩形 · Shift 添加 · Option 减去 · 拖移中再按 Shift 为正方形 · 在内部拖移以移动 · ⌘-拖移可移动像素 · Delete 清除 · ⌘D 取消选择"
          }
        }
      }
    },
    "Drag a text box · Click text to edit · Drag box handles to resize · ⌘Return finish · Escape cancel" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖移出文本框 · 点按文字以编辑 · 拖移文本框控制点以调整大小 · ⌘Return 完成 · Esc 取消"
          }
        }
      }
    },
    "Drag an ellipse · Shift add · Option subtract · Shift again mid-drag circle · Drag inside to move · Delete clears · ⌘D deselect" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖移出椭圆 · Shift 添加 · Option 减去 · 拖移中再按 Shift 为正圆 · 在内部拖移以移动 · Delete 清除 · ⌘D 取消选择"
          }
        }
      }
    },
